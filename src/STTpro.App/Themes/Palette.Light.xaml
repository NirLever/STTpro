<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ==========================================================
         LIGHT THEME PALETTE
         Every brush key here has an identical twin in Palette.Dark.xaml.
         The whole palette dictionary is swapped at runtime by ThemeManager,
         so anything referencing these keys via DynamicResource re-themes live.
         ========================================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgPrimary"   Color="#FFF4F5F7"/>
    <SolidColorBrush x:Key="BgCard"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BgInput"     Color="#FFEDEEF2"/>
    <SolidColorBrush x:Key="BgElevated"  Color="#FFFFFFFF"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderColor"  Color="#FFE3E3E9"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#FFCFCFD6"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF56565E"/>
    <SolidColorBrush x:Key="TextMuted"     Color="#FF8E8E96"/>
    <SolidColorBrush x:Key="TextOnAccent"  Color="#FFFFFFFF"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBlue"      Color="#FF007AFF"/>
    <SolidColorBrush x:Key="AccentBlueHover" Color="#FF2B90FF"/>
    <SolidColorBrush x:Key="AccentGreen"     Color="#FF2FA84C"/>
    <SolidColorBrush x:Key="AccentRed"       Color="#FFFF3B30"/>
    <SolidColorBrush x:Key="AccentOrange"    Color="#FFD97A00"/>

    <!-- Overlays / tints (used for hover, selection, badges) -->
    <SolidColorBrush x:Key="HoverOverlay"        Color="#0F000000"/>
    <SolidColorBrush x:Key="PressOverlay"        Color="#18000000"/>
    <SolidColorBrush x:Key="SelectedOverlay"     Color="#14007AFF"/>
    <SolidColorBrush x:Key="OverlaySubtle"       Color="#0A000000"/>
    <SolidColorBrush x:Key="BadgeBlueBg"         Color="#14007AFF"/>
    <SolidColorBrush x:Key="BadgeOrangeBg"       Color="#1AD97A00"/>
    <SolidColorBrush x:Key="AccentBorderSubtle"  Color="#40007AFF"/>
    <SolidColorBrush x:Key="ScrollThumb"         Color="#33000000"/>
    <SolidColorBrush x:Key="ScrollThumbHover"    Color="#55000000"/>

    <!-- Shadow (used by card drop shadows) -->
    <Color x:Key="ShadowColor">#25000000</Color>

    <!-- True when the dark palette is active. Consumers can trigger off it. -->
    <sys:Boolean xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IsDarkTheme">False</sys:Boolean>
</ResourceDictionary>
