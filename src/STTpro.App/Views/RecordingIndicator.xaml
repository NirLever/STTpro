<Window x:Class="STTpro.App.Views.RecordingIndicator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Width" Height="44"
        Loaded="Window_Loaded">
    <Grid>
        <!-- Light-themed pill indicator -->
        <Border x:Name="PillBorder"
                CornerRadius="22"
                Background="{DynamicResource BgElevated}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                Padding="14,6,10,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.28"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Pulsing red dot -->
                <Ellipse x:Name="RecordingDot"
                         Width="10" Height="10"
                         Fill="#FFFF3B30"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="Opacity"
                                        From="1.0" To="0.3"
                                        Duration="0:0:0.8"
                                        AutoReverse="True">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <!-- Timer text -->
                <TextBlock x:Name="TimerText"
                           Text="0:00"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="14"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <!-- Live audio waveform (bars driven by mic level) -->

                <StackPanel x:Name="WavePanel" Orientation="Horizontal" VerticalAlignment="Center"

                            Margin="10,0,2,0" Height="22">

                    <Rectangle x:Name="Bar0" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>

                    <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>

                    <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>

                    <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>

                    <Rectangle x:Name="Bar4" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>

                    <Rectangle x:Name="Bar5" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>

                    <Rectangle x:Name="Bar6" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>

                    <Rectangle x:Name="Bar7" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>

                    <Rectangle x:Name="Bar8" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>

                    <Rectangle x:Name="Bar9" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>

                </StackPanel>

                <!-- Shown when the mic delivers no signal (muted / wrong device) -->

                <TextBlock x:Name="NoSignalWarning" Text="no mic signal" Visibility="Collapsed"

                           Foreground="{DynamicResource AccentOrange}" FontSize="10.5" FontWeight="SemiBold"

                           VerticalAlignment="Center" Margin="8,0,0,0"/>

                <!-- Prompt indicator -->
                <TextBlock x:Name="PromptLabel"
                           Text=""
                           Foreground="{DynamicResource AccentBlue}"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>

                <!-- Stop button (finish and transcribe) - square icon -->
                <Border x:Name="StopBtn" Cursor="Hand" Margin="10,0,0,0"
                        Background="Transparent" CornerRadius="11"
                        Width="22" Height="22" VerticalAlignment="Center"
                        MouseLeftButtonDown="StopBtn_Click"
                        ToolTip="Stop and transcribe">
                    <Rectangle Width="9" Height="9" Fill="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RadiusX="1" RadiusY="1"/>
                </Border>

                <!-- Cancel button (discard recording) - x icon -->
                <Border x:Name="CancelBtn" Cursor="Hand" Margin="2,0,2,0"
                        Background="Transparent" CornerRadius="11"
                        Width="22" Height="22" VerticalAlignment="Center"
                        MouseLeftButtonDown="CancelBtn_Click"
                        ToolTip="Cancel and discard">
                    <TextBlock Text="&#xd7;" FontSize="15"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-2,0,0"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
