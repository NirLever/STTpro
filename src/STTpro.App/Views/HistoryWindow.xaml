<Window x:Class="STTpro.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STTpro - Transcript History" Height="580" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI">

    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Transcript" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}"/>
            <TextBlock Text=" History" FontSize="21" FontWeight="Light" Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" FontSize="13" KeyUp="SearchBox_KeyUp"/>
            <Button Grid.Column="1" Content="Search" Margin="8,0,0,0" Click="Search_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <ListBox x:Name="TranscriptList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource HistoryItem}"
                     SelectionChanged="TranscriptList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                                    <Border Background="{DynamicResource BadgeBlueBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DetectedLanguage}" FontSize="10" Foreground="{DynamicResource AccentBlue}"/>
                                    </Border>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding DurationSeconds, StringFormat='{}{0:F1}s'}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" FontSize="10" Foreground="{DynamicResource TextMuted}"
                                           Text="{Binding TargetWindowName}" MaxWidth="150"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" MaxHeight="54"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CopyBtn" Content="Copy" Click="Copy_Click" Margin="0,0,8,0"/>
            <Button x:Name="DeleteBtn" Content="Delete" Click="Delete_Click" Margin="0,0,8,0" Style="{StaticResource DeleteButton}"/>
            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
