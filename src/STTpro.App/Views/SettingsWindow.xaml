<Window x:Class="STTpro.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STTpro" Height="740" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinHeight="520" MinWidth="460"
        Background="{DynamicResource BgPrimary}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="22,18,22,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="STT" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}"/>
                <TextBlock Text="pro" FontSize="23" FontWeight="Light" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>
            <TextBlock Text="Speech to text, everywhere you type" FontSize="12"
                       Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0"/>
        </StackPanel>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Margin="16,12,16,16" Background="Transparent" BorderThickness="0">

            <!-- ==================== SETTINGS TAB ==================== -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0" Margin="0,4,0,0">
                    <StackPanel Margin="4,12,10,4">

                        <!-- API Providers Card (combined) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="API PROVIDERS" Style="{StaticResource SectionLabel}"/>

                                <!-- STT row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="STT" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <ComboBox x:Name="SttProviderCombo" Grid.Column="1" SelectionChanged="SttProvider_Changed"/>
                                    <ComboBox x:Name="SttModelCombo" Grid.Column="3" IsEditable="True"
                                              SelectionChanged="SttModel_Changed" LostFocus="SttModel_Changed"
                                              MaxDropDownHeight="400"/>
                                </Grid>

                                <!-- LLM row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LLM" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <ComboBox x:Name="LlmProviderCombo" Grid.Column="1" SelectionChanged="LlmProvider_Changed"/>
                                    <ComboBox x:Name="LlmModelCombo" Grid.Column="3" IsEditable="True"
                                              SelectionChanged="LlmModel_Changed" LostFocus="LlmModel_Changed"
                                              MaxDropDownHeight="400"/>
                                </Grid>

                                <!-- Capability hint -->
                                <TextBlock x:Name="SttCapabilityHint" FontSize="10.5" Foreground="{DynamicResource AccentGreen}" Margin="0,0,0,4"/>

                                <!-- API Key section -->
                                <StackPanel x:Name="SttApiKeyPanel" Margin="0,6,0,0">
                                    <TextBlock x:Name="ApiKeyLabel" Text="API Key" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="SttApiKeyBox" Grid.Column="0" GotFocus="ApiKeyBox_GotFocus"/>
                                        <Button x:Name="SaveSttApiKeyBtn" Grid.Column="1" Content="Save" Margin="8,0,0,0"
                                                Click="SaveSttApiKey_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="SttApiKeyStatus" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Shared key checkbox (only when same provider type) -->
                                <CheckBox x:Name="UseSharedApiKeyCheck" Content="Use same API key for LLM"
                                          Checked="UseSharedApiKey_Changed" Unchecked="UseSharedApiKey_Changed"
                                          Margin="0,4,0,0"/>

                                <!-- Separate LLM key (only when different providers) -->
                                <StackPanel x:Name="LlmApiKeyPanel" Margin="0,6,0,0">
                                    <TextBlock x:Name="LlmApiKeyLabel" Text="LLM API Key" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="LlmApiKeyBox" Grid.Column="0" GotFocus="ApiKeyBox_GotFocus"/>
                                        <Button x:Name="SaveLlmApiKeyBtn" Grid.Column="1" Content="Save" Margin="8,0,0,0"
                                                Click="SaveLlmApiKey_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="LlmApiKeyStatus" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Base URL overrides -->
                                <StackPanel x:Name="SttBaseUrlPanel" Margin="0,6,0,0">
                                    <TextBlock Text="STT Base URL" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SttBaseUrlBox" LostFocus="SttBaseUrl_Changed"/>
                                    <TextBlock x:Name="SttBaseUrlHint" Style="{StaticResource HintLabel}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="LlmBaseUrlPanel" Margin="0,6,0,0">
                                    <TextBlock Text="LLM Base URL" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LlmBaseUrlBox" LostFocus="LlmBaseUrl_Changed"/>
                                    <TextBlock x:Name="LlmBaseUrlHint" Style="{StaticResource HintLabel}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hidden elements for compat -->
                        <PasswordBox x:Name="ApiKeyBox" Visibility="Collapsed"/>
                        <TextBlock x:Name="LlmCapabilityHint" Visibility="Collapsed"/>

                        <!-- Usage Card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="API USAGE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Estimated API costs based on usage. Actual billing may vary."
                                           Style="{StaticResource HintLabel}" Margin="0,-4,0,10" FontStyle="Italic"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Transcriptions" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="UsageCountLabel" Text="0" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Audio Minutes" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="UsageMinutesLabel" Text="0.0" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Est. Cost (approx)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="UsageCostLabel" Text="$0.00" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="UsageDetailsLabel" Text="" Style="{StaticResource HintLabel}" Margin="0,8,0,0"/>
                                <Button Content="Reset Usage" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Style="{StaticResource MiniButton}" Click="ResetUsage_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Audio Card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="AUDIO" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Microphone" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="MicrophoneCombo" SelectionChanged="Microphone_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- Transcription Card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="TRANSCRIPTION" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Language" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="LanguageCombo" SelectionChanged="Language_Changed" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Auto-detect" Tag=""/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                    <ComboBoxItem Content="Hebrew" Tag="he"/>
                                    <ComboBoxItem Content="French" Tag="fr"/>
                                    <ComboBoxItem Content="Spanish" Tag="es"/>
                                    <ComboBoxItem Content="German" Tag="de"/>
                                    <ComboBoxItem Content="Arabic" Tag="ar"/>
                                    <ComboBoxItem Content="Russian" Tag="ru"/>
                                </ComboBox>
                                <TextBlock Text="Output Mode" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="OutputModeCombo" SelectionChanged="OutputMode_Changed">
                                    <ComboBoxItem Content="Clipboard Paste (Ctrl+V)" Tag="ClipboardPaste"/>
                                    <ComboBoxItem Content="Direct Typing (Unicode)" Tag="DirectTyping"/>
                                    <ComboBoxItem Content="Copy to Clipboard Only" Tag="CopyOnly"/>
                                    <ComboBoxItem Content="Save to History Only" Tag="SaveOnly"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Smart Prompts Card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SMART PROMPTS" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="0,-4,0,10">
                                    <Run Text="Press the hotkey (default Ctrl+Shift+1, 2, 3...) to record with a prompt. Your recording is post-processed through the selected prompt."/>
                                    <LineBreak/>
                                    <Run Text="Click a name or text below to edit a prompt." FontStyle="Italic"/>
                                </TextBlock>

                                <!-- Prompt Hotkey Mode -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mode:" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="PromptModeToggle" Content="Toggle (press to start / stop)"
                                                     GroupName="PromptMode" Margin="0,0,18,0"
                                                     Checked="PromptMode_Changed"/>
                                        <RadioButton x:Name="PromptModeHold" Content="Hold (record while held)"
                                                     GroupName="PromptMode"
                                                     Checked="PromptMode_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <ItemsControl x:Name="PromptsPanel">
                                    <!-- Prompts are added dynamically in code-behind -->
                                </ItemsControl>

                                <Button Content="+ Add Prompt" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Style="{StaticResource MiniButton}" Click="AddPrompt_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Hotkeys Card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="HOTKEYS" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Click a hotkey, then hold your modifiers (Ctrl / Shift / Alt / Win) and press the final key — e.g. Ctrl + Shift + M. It saves automatically. Press Escape or click away to cancel."
                                           Style="{StaticResource HintLabel}" Margin="0,-4,0,12"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hold to talk" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                                    <Button x:Name="HoldToTalkBtn" Grid.Column="1" Style="{StaticResource HotkeyButton}"
                                            Click="HoldToTalkBtn_Click"/>
                                    <Button Grid.Column="2" Content="Reset" Style="{StaticResource MiniButton}"
                                            Margin="6,0,0,0" Click="RevertHoldToTalk_Click" ToolTip="Reset to Ctrl + Space"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Toggle recording" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                                    <Button x:Name="ToggleRecordingBtn" Grid.Column="1" Style="{StaticResource HotkeyButton}"
                                            Click="ToggleRecordingBtn_Click"/>
                                    <Button Grid.Column="2" Content="Reset" Style="{StaticResource MiniButton}"
                                            Margin="6,0,0,0" Click="RevertToggleRecording_Click" ToolTip="Reset to Ctrl + Shift + Space"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Paste last" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                                    <Button x:Name="PasteLastBtn" Grid.Column="1" Style="{StaticResource HotkeyButton}"
                                            Click="PasteLastBtn_Click"/>
                                    <Button Grid.Column="2" Content="Reset" Style="{StaticResource MiniButton}"
                                            Margin="6,0,0,0" Click="RevertPasteLast_Click" ToolTip="Reset to Ctrl + Shift + V"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Options Card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="OPTIONS" Style="{StaticResource SectionLabel}"/>
                                <CheckBox x:Name="ShowIndicatorCheck" Content="Show recording indicator"
                                          Checked="ShowIndicator_Changed" Unchecked="ShowIndicator_Changed"/>
                                <CheckBox x:Name="RestoreClipboardCheck" Content="Restore clipboard after paste"
                                          Checked="RestoreClipboard_Changed" Unchecked="RestoreClipboard_Changed"/>
                                <CheckBox x:Name="AddTrailingPeriodCheck" Content="Add period at end of sentences"
                                          Checked="AddTrailingPeriod_Changed" Unchecked="AddTrailingPeriod_Changed"/>
                                <CheckBox x:Name="SkipShortRecordingsCheck" Content="Skip recordings under 1 second"
                                          Checked="SkipShortRecordings_Changed" Unchecked="SkipShortRecordings_Changed"/>
                                <CheckBox x:Name="LaunchOnStartupCheck" Content="Launch on Windows startup"
                                          Checked="LaunchOnStartup_Changed" Unchecked="LaunchOnStartup_Changed"/>

                                <!-- Silence sensitivity -->
                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Silence sensitivity:" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="SilenceThresholdLabel" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Slider x:Name="SilenceSlider" Minimum="0.3" Maximum="0.95"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            ValueChanged="SilenceSlider_Changed" Margin="0,6,0,0"/>
                                    <TextBlock Text="Lower = keep more audio (less filtering). Higher = filter out more silence/noise."
                                               Style="{StaticResource HintLabel}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="History retention:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="HistoryRetentionCombo" SelectionChanged="HistoryRetention_Changed" Width="190">
                                        <ComboBoxItem Content="Save everything" Tag="0"/>
                                        <ComboBoxItem Content="Keep last 20" Tag="20"/>
                                        <ComboBoxItem Content="Keep last 50" Tag="50"/>
                                        <ComboBoxItem Content="Keep last 100" Tag="100"/>
                                        <ComboBoxItem Content="Keep last 500" Tag="500"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Appearance:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="AppearanceCombo" SelectionChanged="Appearance_Changed" Width="190">
                                        <ComboBoxItem Content="Follow Windows" Tag="system"/>
                                        <ComboBoxItem Content="Light" Tag="light"/>
                                        <ComboBoxItem Content="Dark" Tag="dark"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Reset to Defaults -->
                        <Button Content="Reset All Settings to Default" HorizontalAlignment="Stretch"
                                Style="{StaticResource SecondaryButton}" Click="ResetToDefaults_Click"
                                Margin="0,0,0,10"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== HISTORY TAB ==================== -->
            <TabItem Header="History">
                <Grid Margin="4,16,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HistorySearchBox" Grid.Column="0" FontSize="13"/>
                        <Button Grid.Column="1" Content="Search" Margin="8,0,0,0" Click="HistorySearch_Click"/>
                    </Grid>

                    <!-- Transcript list -->
                    <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="12"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource HistoryItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Copy" Click="HistoryCopy_Click" Margin="0,0,6,0"/>
                        <Button Content="Delete" Click="HistoryDelete_Click"
                                Style="{StaticResource DeleteButton}" Margin="0,0,6,0"/>
                        <Button Content="Refresh" Click="HistoryRefresh_Click"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                        <Button Content="Export JSON" Click="ExportJson_Click"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                        <Button Content="Export Text" Click="ExportText_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <!-- Privacy note -->
                    <TextBlock Grid.Row="3" Margin="0,10,0,0"
                               Text="All transcriptions are stored locally on this device and are never sent anywhere."
                               Style="{StaticResource HintLabel}" FontStyle="Italic"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
