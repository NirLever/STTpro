<Window x:Class="STTpro.App.Views.ResetSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Settings"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource BgCard}" CornerRadius="14" Margin="12"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#40000000" BlurRadius="18" ShadowDepth="3" Opacity="0.35"/>
        </Border.Effect>

        <StackPanel Margin="26,22,26,22">
            <TextBlock Text="Reset Settings" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,20"
                       LineHeight="20">
                This will restore all settings to their defaults. Your API keys and transcription history will not be affected.
            </TextBlock>

            <CheckBox x:Name="ResetPromptsCheck" Content="Also reset prompts to defaults"
                      FontSize="13" Margin="0,0,0,22"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}" MinWidth="92"/>
                <Button Grid.Column="3" Content="Reset" Click="Reset_Click"
                        Style="{StaticResource DeleteButton}" MinWidth="92"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
