<Window x:Class="STTpro.App.Views.ResetSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Settings"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="#FFFFFFFF" CornerRadius="12" Margin="12"
            BorderBrush="#FFD8D8DC" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#40000000" BlurRadius="16" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>

        <StackPanel Margin="24,20,24,20">
            <!-- Title -->
            <TextBlock Text="Reset Settings" FontSize="17" FontWeight="SemiBold"
                       Foreground="#FF1D1D1F" Margin="0,0,0,12"/>

            <!-- Description -->
            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#FF555555" Margin="0,0,0,20"
                       LineHeight="20">
                This will restore all settings to their defaults. Your API keys and transcription history will not be affected.
            </TextBlock>

            <!-- Option: include prompts -->
            <CheckBox x:Name="ResetPromptsCheck" Content="Also reset prompts to defaults"
                      FontSize="13" Foreground="#FF1D1D1F" Margin="0,0,0,20" Cursor="Hand"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click"
                        Padding="20,8" FontSize="13" Cursor="Hand" MinWidth="90">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFF0F0F2"/>
                            <Setter Property="Foreground" Value="#FF1D1D1F"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#FFD8D8DC"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="3" Content="Reset" Click="Reset_Click"
                        Padding="20,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand" MinWidth="90">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFFF3B30"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
